rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Kept exactly as the current Console rules for Module 1 import/test.
    match /calendarImports/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Profiles are private and can only be read by their owner.
      allow read: if signedIn() && request.auth.uid == userId;

      // A client-created profile must be its own profile and a normal USER.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.systemRole == 'USER'
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'systemRole',
          'status',
          'createdAt',
          'updatedAt',
          'lastLoginAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'systemRole',
          'status',
          'createdAt',
          'updatedAt',
          'lastLoginAt'
        ]);

      // Clients can update only profile metadata; all permission fields stay unchanged.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.systemRole == resource.data.systemRole
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'updatedAt',
          'lastLoginAt'
        ]);

      allow delete: if false;
    }
  }
}
