rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Calendar lookup remains public. Import writes use the trusted,
    // materialized effective permission document.
    match /calendarImports/{document=**} {
      allow read: if true;
      allow write: if hasPermission('calendar.import');
    }

    function signedIn() {
      return request.auth != null;
    }

    function hasPermission(permission) {
      return signedIn()
        && exists(/databases/$(database)/documents/userAuthorizations/$(request.auth.uid))
        && get(/databases/$(database)/documents/userAuthorizations/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/userAuthorizations/$(request.auth.uid)).data.permissions is list
        && permission in get(/databases/$(database)/documents/userAuthorizations/$(request.auth.uid)).data.permissions;
    }

    function ownsAssignedRole(roleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customRoles is list
        && roleId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customRoles;
    }

    function isSystemRoleId(roleId) {
      return roleId == 'ROOT_ADMIN'
        || roleId == 'SUPER_ADMIN'
        || roleId == 'ADMIN'
        || roleId == 'EDITOR'
        || roleId == 'USER';
    }

    // This is the Rules-side allowlist. It intentionally excludes role-management
    // and user-delete capabilities from Custom Roles.
    function isCustomPermission(permission) {
      return permission in [
        'users.read', 'users.create', 'users.update', 'roles.read',
        'calendar.search', 'calendar.export', 'calendar.import',
        'news.read', 'news.create', 'news.update', 'news.delete', 'news.publish',
        'quiz.question.read', 'quiz.question.create', 'quiz.question.update',
        'quiz.question.delete', 'quiz.exam.create', 'quiz.exam.update',
        'quiz.exam.publish', 'quiz.exam.delete', 'approval.create',
        'approval.review', 'audit.read'
      ];
    }

    // Firestore Rules have no JavaScript import/loop over the code catalog.
    // The bounded checks below reject unknown permissions in a role document.
    function validCustomPermissionList(permissions) {
      return permissions is list
        && permissions.size() <= 32
        && (permissions.size() < 1 || isCustomPermission(permissions[0]))
        && (permissions.size() < 2 || isCustomPermission(permissions[1]))
        && (permissions.size() < 3 || isCustomPermission(permissions[2]))
        && (permissions.size() < 4 || isCustomPermission(permissions[3]))
        && (permissions.size() < 5 || isCustomPermission(permissions[4]))
        && (permissions.size() < 6 || isCustomPermission(permissions[5]))
        && (permissions.size() < 7 || isCustomPermission(permissions[6]))
        && (permissions.size() < 8 || isCustomPermission(permissions[7]))
        && (permissions.size() < 9 || isCustomPermission(permissions[8]))
        && (permissions.size() < 10 || isCustomPermission(permissions[9]))
        && (permissions.size() < 11 || isCustomPermission(permissions[10]))
        && (permissions.size() < 12 || isCustomPermission(permissions[11]))
        && (permissions.size() < 13 || isCustomPermission(permissions[12]))
        && (permissions.size() < 14 || isCustomPermission(permissions[13]))
        && (permissions.size() < 15 || isCustomPermission(permissions[14]))
        && (permissions.size() < 16 || isCustomPermission(permissions[15]))
        && (permissions.size() < 17 || isCustomPermission(permissions[16]))
        && (permissions.size() < 18 || isCustomPermission(permissions[17]))
        && (permissions.size() < 19 || isCustomPermission(permissions[18]))
        && (permissions.size() < 20 || isCustomPermission(permissions[19]))
        && (permissions.size() < 21 || isCustomPermission(permissions[20]))
        && (permissions.size() < 22 || isCustomPermission(permissions[21]))
        && (permissions.size() < 23 || isCustomPermission(permissions[22]))
        && (permissions.size() < 24 || isCustomPermission(permissions[23]))
        && (permissions.size() < 25 || isCustomPermission(permissions[24]))
        && (permissions.size() < 26 || isCustomPermission(permissions[25]))
        && (permissions.size() < 27 || isCustomPermission(permissions[26]))
        && (permissions.size() < 28 || isCustomPermission(permissions[27]))
        && (permissions.size() < 29 || isCustomPermission(permissions[28]))
        && (permissions.size() < 30 || isCustomPermission(permissions[29]))
        && (permissions.size() < 31 || isCustomPermission(permissions[30]))
        && (permissions.size() < 32 || isCustomPermission(permissions[31]));
    }

    function validCustomRole(data, roleId) {
      return data.keys().hasOnly([
          'id', 'name', 'description', 'type', 'status', 'permissions',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id == roleId
        && !isSystemRoleId(roleId)
        && data.type == 'CUSTOM'
        && (data.status == 'active' || data.status == 'disabled')
        && data.name is string
        && data.name.size() > 0
        && data.description is string
        && validCustomPermissionList(data.permissions);
    }

    match /users/{userId} {
      allow read: if hasPermission('users.read') || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.systemRole == 'USER'
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoURL', 'systemRole', 'status',
          'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'systemRole', 'status',
          'createdAt', 'updatedAt', 'lastLoginAt'
        ]);

      // Owner profile metadata update. customRoles/systemRole/status are excluded.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.systemRole == resource.data.systemRole
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'updatedAt', 'lastLoginAt'
        ]);

      allow delete: if false;
    }

    match /roles/{roleId} {
      allow get: if hasPermission('roles.read') || ownsAssignedRole(roleId);
      allow list: if hasPermission('roles.read');

      // Creating a new role cannot invalidate an existing authorization.
      allow create: if hasPermission('roles.create')
        && validCustomRole(request.resource.data, roleId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Browser updates are metadata-only. Permission/status changes must use
      // trusted tooling so affected authorizations are rebuilt.
      allow update: if hasPermission('roles.update')
        && resource.data.type == 'CUSTOM'
        && validCustomRole(request.resource.data, roleId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /userAuthorizations/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
